flowchart TD
    A(["insertOrder(graph, vehicle, remaining, newOrder, pos, now, weight, onboard, stash)"]) --> B["all = remaining + newOrder<br/>（urgent 标记由调用方给出，本函数照用，不再强制 urgent）"]
