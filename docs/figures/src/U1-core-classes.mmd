%% U1 类图：core 层（零 Qt，可单独编译）
%% 依据 src/core/Node.h       struct Node · enum NodeType · toString/parseNodeType
%%      src/core/Edge.h       struct Edge
%%      src/core/WeightType.h enum WeightType · pickWeight
%%      src/core/Order.h      struct Order
%%      src/core/Vehicle.h    struct Vehicle
%%      src/core/LogisticsGraph.h class LogisticsGraph
%%      src/core/MinHeap.h    class MinHeap（Entry 在类内 private）
%%      src/core/Dijkstra.h   struct PathResult + 自由函数 shortestPath
%%      src/core/RoutePlanner.h  struct Stop/StopDelivery/OffloadLeg/StashState/RoutePlan/OnboardItem/InsertResult
%%                            + enum class LegKind / struct Leg（规格三 §1：腿与就绪链）
%%                            + struct TransitLeg（转运账本的两端齐全记录）
%%                            + struct CustodyGap / CustodyReport + 自由函数 auditCustody（custody 审计）
%%                            + struct FleetPlan（legs / transitLegs / allocation*）/ VehicleStartState
%%                            + struct FleetRescheduleInput / FleetRescheduleResult（level 1–5）
%%                            + 自由函数 planRoute/replan/insertOrder/replanIncremental
%%                            + sliceRemainder/replanIncremental/isEdgeOnRoute
%%                            + nodeIndexAtTime
%%                            + planFleet / buildLegs / legVehicleEligible / chooseLegVehicle / fastVehicleFlags
%%                            + buildTransitLedger / applyTransitLayer
%%                            + rescheduleFleet / localReplanTwoVersion / chooseVehicleForNewOrder
%%                            + affectedVehiclesForTraffic / affectedVehiclesForClosure / aggregateFleet
%%                            + 常量 kLookaheadWindowMin（60，车等货上限）
%%      src/core/Traffic.h    struct TrafficChange/TrafficReport + 自由函数
%%                            simulateTrafficChange/needsReplan
%%      src/core/SimEvent.h   enum SimEventKind · struct EventWeights + 自由函数
%%                            pickEvent/nextEventTimeMin/simEventName
%%      src/core/GraphEdit.h  自由函数 addRandomCustomer/closeRandomRoad/makeSyntheticEdge
%%      src/core/Config.h     struct GeneralConfig / Config
%%      src/core/Random.h     class Rng
%%      src/io/IniFile.h      struct IniRecord/IniSection + class IniFile
%%      src/io/ConfigLoader.h class ConfigLoader（io 层，因 Config 的关系画在此处）
%% ----
%% 重要读法：
%%  · Dijkstra / RoutePlanner / Traffic / SimEvent / GraphEdit 不是类，是
%%    logistics 命名空间下的自由函数集合（<<utility>>）。源码里没有 class RoutePlanner。
%%  · tryInsertPair / replay / repairRoute / buildAll / insertionStarts / finalize 等（匿名命名空间，无头文件声明）
%%    在 RoutePlanner.cpp 的匿名命名空间里，无头文件声明，只在 F3/F4/F5/F6 出现。
%%  · 行号不写：会漂，用符号名。
classDiagram
    direction LR

    namespace 领域类型 {
        class Node {
            +string id
            +NodeType type
            +double x, y
            +string name
            +int subNetworkId
        }
        class Edge {
            +string fromId, toId
            +double distanceKm
            +double timeMin
            +double costYuan
            +double baseTimeMin
            +bool congested
        }
        class Order {
            +string id
            +string nodeId（送达点 B）
            +string pickupNodeId（取货点 A，必填）
            +double demandKg
            +int windowStartMin
            +int windowEndMin
            +bool urgent, picked, served
            +OrderSource source（运行时）
        }
        class Vehicle {
            +string id, startNodeId
            +double capacityKg
            +int departTimeMin
            +double timeFactor
            +double costFactor
        }
    }

    namespace 图与堆 {
        class LogisticsGraph {
            -vector~Node~ nodes_
            -vector~vector~Edge~~ out_
            +addNode(node) bool
            +removeNode(id) bool
            +addEdge(edge) bool
            +removeEdge(from, to) bool
            +updateEdgeTime(from, to, newTime) bool
            +findNode(id) Node*
            +findEdge(from, to) Edge*
            +nodes() vector~Node~
            +outEdges(id) vector~Edge~
            +edges() vector~Edge~
            +adjacency() vector
            +indexOf(id) int
            +nodeCount() size_t
            +edgeCount() size_t
            +toAdjacencyListString() string
            +toAdjacencyMatrixString(w) string
        }
        class MinHeap {
            -vector~Entry~ entries_
            +push(key, value)
            +popMin(key, value) bool
            +empty() bool
            +size() size_t
            -siftUp(index)
            -siftDown(index)
            -swapEntries(a, b)$
        }
        class PathResult {
            +bool found
            +vector~string~ nodes
            +double totalWeight
        }
    }

    namespace 路径规划结果 {
        class StopDelivery {
            +string orderId
            +bool late
            +int penaltyMin
        }
        class Stop {
            +string nodeId
            +vector~StopDelivery~ deliveries
            +vector~string~ pickups
            +vector~string~ offloads
            +vector~string~ reclaims
            +vector~string~ transitUnloads（转运卸入：交给另一台车）
            +vector~string~ transitPickups（转运取走：由另一台车卸入）
            +StopPhase phase
            +int rawArrivalMin
            +int waitMin
            +int arrivalMin
            +bool late
            +int penaltyMin
            +double remainingLoadKg
        }
        class OffloadLeg {
            +string station
            +string orderId
            +string deliverNodeId
            +double kg
            +int offloadTimeMin
            +int reclaimTimeMin
        }
        class StashState {
            +string station
            +vector~OnboardItem~ items
        }
        class OrderMetric {
            +string orderId
            +string nodeId
            +bool urgent
            +int pickupArrivalMin
            +int deliveryArrivalMin
            +int windowEndMin
            +int penaltyMin
            +bool late
            +bool pickupOnTime
            +bool deliveryOnTime
        }
        class RouteMetrics {
            +int stopCount
            +int actionCount
            +vector~OrderMetric~ orders
            +int pickupOnTimeCount
            +int deliveryOnTimeCount
            +double avgLoadKg
            +double loadUtilization
            +double peakLoadKg
        }
        class RoutePlan {
            +PlanStatus status
            +string reason
            +vector~string~ nodes
            +vector~int~ nodeArrivalMin
            +vector~bool~ nodeIsStop
            +vector~Stop~ stops
            +vector~OffloadLeg~ offloads
            +map~string_double~ transitKg（账本渲染用的易手 kg）
            +RouteMetrics metrics
            +double totalDistanceKm
            +double totalTimeMin
            +int returnArrivalMin
            +double totalCostYuan
            +int totalPenaltyMin
        }
        class OnboardItem {
            +string nodeId
            +double kg
            +string orderId
        }
        class InsertResult {
            +RoutePlan plan
            +string warning
        }
        class LegKind {
            <<enumeration>>
            +CustomerToCustomer（本地单：客户 → 客户）
            +CustomerToStation（跨簇 L1：客户 → 本簇站）
            +StationToStation（跨簇 L2：本簇站 → 对簇站，只能由快车执行）
            +StationToCustomer（跨簇 L3：对簇站 → 客户）
        }
        class Leg {
            +int seq（本地单恒 1；跨簇单 1 → 2 → 3）
            +string from, to
            +LegKind kind
            +string orderId（跨簇单 3 条腿同单号）
            +int readyTimeMin（L1=发车；L2=L1 完成；L3=L2 完成）
            +int plannedArrivalMin
            +string vehicleId（职责表定）
            +bool temporaryAssignment（true=规划期估计）
            +bool urgent
            +int directPenaltyMin
            +int relayPenaltyMin
        }
        class TransitLeg {
            +string orderId, stationId
            +double kg（= 订单需求）
            +string inVehicleId（卸入车）
            +int inTimeMin
            +string outVehicleId（取走车）
            +int outTimeMin
        }
        class CustodyGap {
            +string orderId
            +string stationId
            +string kind（unload-no-pickup / pickup-no-unload / kg-mismatch / undelivered-not-rejected）
            +string detail
        }
        class CustodyReport {
            +bool ok
            +vector~CustodyGap~ gaps
        }
        class FleetPlan {
            +vector~RoutePlan~ vehicles
            +vector~Leg~ legs（按订单 ID 升序、同单内腿序 1→3）
            +vector~string~ legLog
            +vector~TransitLeg~ transitLegs（buildTransitLedger 的结果）
            +vector~string~ allocationOrderIds
            +vector~int~ vehicleClusters
            +double completionTimeMin
            +double balanceSpread
        }
    }
    namespace core 自由函数 {
        class Dijkstra {
            <<utility>>
            +shortestPath(graph, source, target, weight) PathResult$
        }
        class RoutePlanner {
            <<utility>>
            +planRoute(graph, vehicle, orders, weight) RoutePlan$
            +replan(graph, vehicle, orders, pos, time, weight, onboard, stash) RoutePlan$
            +insertOrder(graph, vehicle, orders, newOrder, pos, time, weight, onboard, stash) InsertResult$
            +sliceRemainder(plan, fromNodeIndex) RoutePlan$
            +replanIncremental(..., usedIncremental) RoutePlan$
            +isEdgeOnRoute(routeNodes, fromId, toId) bool$
            +nodeIndexAtTime(plan, timeMin) size_t$
            +planFleet / planFleetSequentialBaseline / aggregateFleet(...)$
            +buildLegs(graph, vehicles, orders, fleet, log) vector~Leg~$
            +legVehicleEligible(...) / chooseLegVehicle(...) / fastVehicleFlags(vehicles)$
            +buildTransitLedger(vehicles, plans) vector~TransitLeg~$
            +applyTransitLayer(...) FleetTransitResult$
            +rescheduleFleet(...) FleetRescheduleResult$
            +auditCustody(vehicles, plans, orders, rejected) CustodyReport$
            +localReplanTwoVersion / chooseVehicleForNewOrder / affectedVehiclesForTraffic / affectedVehiclesForClosure$
            +finalize(内部)：stops → 扁平视图 + 指标
        }
        class Traffic {
            <<utility>>
            +simulateTrafficChange(graph, ratio, minR, maxR, seed, clearProb) TrafficReport$
            +needsReplan(routeNodes, report, thresholdRatio) bool$
        }
        class SimEvent {
            <<utility>>
            +pickEvent(weights, rng) SimEventKind$
            +nextEventTimeMin(nowMin, intervalMin) int$
            +simEventName(kind) char*$
        }
        class GraphEdit {
            <<utility>>
            +addRandomCustomer(graph, rng) string$
            +closeRandomRoad(graph, rng) string$
            +makeSyntheticEdge(graph, from, to, out) bool$
        }
    }

    LogisticsGraph "1" *-- "*" Node : nodes_ 顺序表
    LogisticsGraph "1" *-- "*" Edge : out_ 邻接表（下标与 nodes_ 严格对齐）
    MinHeap ..> Dijkstra : 供 shortestPath 使用（依赖箭头指向被依赖方）
    Dijkstra ..> LogisticsGraph : adjacency() / indexOf() 只读
    Dijkstra ..> MinHeap : push / popMin（惰性删除，无 decrease-key）
    Dijkstra ..> PathResult : 返回
    RoutePlanner ..> Dijkstra : CostMatrix 建表（V×3 次最短路）/ 冲突判定
    RoutePlanner ..> LogisticsGraph : 读取
    RoutePlanner ..> RoutePlan : 生成
    RoutePlanner ..> Traffic : isEdgeOnRoute（needsReplan 复用同一判定）
    Traffic ..> LogisticsGraph : updateEdgeTime（就地改 timeMin，baseTimeMin 不动）
    Traffic ..> TrafficReport : 返回
    TrafficReport "1" *-- "*" TrafficChange : changes
    SimEvent ..> Rng : pickEvent 消耗一次随机数
    GraphEdit ..> LogisticsGraph : 增删节点 / 边
    GraphEdit ..> Rng : 随机位置 / 随机道路
    Config "1" *-- "1" LogisticsGraph : graph
    Config "1" *-- "*" Vehicle : vehicles
    Config "1" *-- "*" Order : orders
    Config "1" *-- "1" GeneralConfig : general
    ConfigLoader ..> IniFile : loadFromFile / parse
    ConfigLoader ..> Config : 组装 + 校验（缺节 / 字段数 / 类型 / 端点 / 重复 ID）
    IniFile "1" *-- "*" IniSection : sections_
    IniSection "1" *-- "*" IniRecord : records（自带 lineNo，报错能指到行）
    RoutePlan "1" *-- "*" Stop : stops（真源）
    RoutePlan "1" *-- "*" OffloadLeg : offloads（降载 custody）
    RoutePlan "1" *-- "1" RouteMetrics : metrics
    Stop "1" *-- "*" StopDelivery : deliveries（逐单 late/penalty）
    RouteMetrics "1" *-- "*" OrderMetric : orders
    StashState "1" o-- "*" OnboardItem : items（跨重规划透传）
    RoutePlan ..> RoutePlan : finalize()：扁平字段由 stops 展平而来，唯一生成点
    InsertResult *-- RoutePlan : plan
    RoutePlan *-- TransitLeg : 经 buildTransitLedger 反查（transitUnloads/transitPickups 配对）
    FleetPlan "1" *-- "*" RoutePlan : vehicles（下标与 [vehicles] 一一对应）
    FleetPlan "1" *-- "*" Leg : legs（结构层真源，--dump-plan 的 LEG 行读它）
    Leg ..> LegKind : kind
    FleetPlan "1" *-- "*" TransitLeg : transitLegs
    CustodyReport "1" *-- "*" CustodyGap : gaps
    RoutePlanner ..> Leg : buildLegs 产出（readyTime 链）
    RoutePlanner ..> CustodyReport : auditCustody 只读 stops 得出
    RoutePlanner ..> FleetPlan : planFleet 产出
    Order ..> RoutePlanner : makeCtx 转成 Request（A/B/kg/逐单窗口）