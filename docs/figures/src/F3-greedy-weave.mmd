%% 落点只写符号名不写行号：行号会漂，符号名不会。
%% 注：本图取代旧 F3「贪心串联 weave」——weave/appendLeg 已随规格一删除（grep 0 命中）。
flowchart TD
    A(["tryInsertPair(ctx, builder, request)"]) --> B["普通段位置对 (i, j)：<br/>A 落在第 i 个停靠之前，B 落在第 j 个停靠之前（j ≥ i）"]
    B --> C{"还有未试的位置对"}
    C -->|是| D["构造候选 StopSpec[]：<br/>插入 A/B 动作；同节点优先并入既有停靠（不新增停靠）"]
    D --> E["replay(ctx, cand, detail=false, ev)：<br/>按 CostMatrix 查每个 leg（耗时 × timeFactor）"]
    E --> F{"F1–F7 全部成立？<br/>① 每单恰一次取送 ② A 先于 B ③ 前缀载重 0..C<br/>④ 硬优先 ⑤ FIFO ⑥ 暂存 ⑦ 时间/逐单 penalty"}
    F -->|否 剪掉| C
    F -->|是| G["等待 = max(0, max ws_i − raw)（本停靠全部送达单都开窗）<br/>arrival = raw + wait；departure = arrival（零耗时）<br/>penalty_i = max(0, arr − we_i)（逐单）"]
    G --> H["compareRoutes(cand, best)：<br/>① Σpenalty ② 该策略权重（Time 维含等待）③ tieKey（节点 ID + 动作 ID）"]
    H --> I{"strictly 更优？"}
    I -->|是| J["best = cand（保存 StopSpec[] 与 key）"] --> C
    I -->|否 并列或更差| C
    C -->|枚举完| K{"best 存在？"}
    K -->|是| L(["返回 true + best<br/>insertNormalAll 采用，继续下一张单"])
    K -->|否| M(["返回 false<br/>交给三级兜底（下一张图）"])
    M --> N["一级：repairRoute（有界 relocate，R ≤ 3）<br/>只动普通段；某轮无改进即停"]
    N --> O["二级：全量兜底（失败单提到普通序最前，整体重跑构造）"]
    O --> P["三级：降载（卸整张普通单到中转站，见 F5）"]
    P --> Q(["仍无解 ⇒ 拒绝该单并报原因<br/>绝不靠违反容量 / 先送后取凑解"])